#include <stdio.h>
 
int main() {
    int t;
    if (scanf("%d", &t) != 1) return 0;
    
    while (t--) {
        int n, k;
        scanf("%d %d", &n, &k);
        
        int found = 0;
        for (int i = 0; i < n; i++) {
            int a;
            scanf("%d", &a);
            if (a == k) {
                found = 1;
            }
        }
        
        if (found) {
            printf("YES
");
        } else {
            printf("NO
");
        }
    }
    
    return 0;
}