#include <stdio.h>
#include <ctype.h>
 
int main(void) {
    int t;
    if (scanf("%d", &t) != 1) {
        return 0;
    }
 
    while (t--) {
        char s[10];
        scanf("%s", s);
 
        if (tolower(s[0]) == 'y' && tolower(s[1]) == 'e' && tolower(s[2]) == 's') {
            printf("YES
");
        } else {
            printf("NO
");
        }
    }
 
    return 0;
}