#include <stdio.h>
 
int main() {
    int t;
    if (scanf("%d", &t) == 1) {
        while (t--) {
            int rating;
            scanf("%d", &rating);
            
            if (rating >= 1900) {
                printf("Division 1
");
            } else if (rating >= 1600) {
                printf("Division 2
");
            } else if (rating >= 1400) {
                printf("Division 3
");
            } else {
                printf("Division 4
");
            }
        }
    }
    return 0;
}