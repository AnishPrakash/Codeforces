#include <stdio.h>
#include <string.h>
 
int main() {
    int t;
    if (scanf("%d", &t) != 1) return 0;
    while (t--) {
        char s[105];
        scanf("%s", s);
        int len = strlen(s);
        if (len % 2 != 0) {
            printf("NO
");
        } else {
            if (strncmp(s, s + len / 2, len / 2) == 0) {
                printf("YES
");
            } else {
                printf("NO
");
            }
        }
    }
    return 0;
}