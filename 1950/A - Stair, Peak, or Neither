#include <stdio.h>
 
int main() {
    int t;
    if (scanf("%d", &t) != 1) return 0;
    while (t--) {
        int a, b, c;
        scanf("%d %d %d", &a, &b, &c);
        if (a < b && b < c) {
            printf("STAIR
");
        } else if (a < b && b > c) {
            printf("PEAK
");
        } else {
            printf("NONE
");
        }
    }
    return 0;
}