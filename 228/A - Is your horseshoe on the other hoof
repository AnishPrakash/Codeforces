#include <stdio.h>
 
int main() {
    int a[4];
    if (scanf("%d %d %d %d", &a[0], &a[1], &a[2], &a[3]) == 4) {
        int distinct = 0;
        for (int i = 0; i < 4; i++) {
            int unique = 1;
            for (int j = 0; j < i; j++) {
                if (a[i] == a[j]) {
                    unique = 0;
                    break;
                }
            }
            distinct += unique;
        }
        printf("%d
", 4 - distinct);
    }
    return 0;
}